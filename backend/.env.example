# Configuración local del backend. Copia este archivo a .env.local y sustituye
# los valores de ejemplo por los de tu base de datos.
SERVER_PORT=8080
POSTGRES_HOST=database.example.com
POSTGRES_PORT=5432
POSTGRES_DB=gasolineras_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-password

# Configuración del Geoportal/MITECO
APP_GEOPORTAL_BASE_URL=https://sedeaplicaciones.minetur.gob.es/ServiciosRESTCarburantes/PreciosCarburantes/EstacionesTerrestres/
APP_GEOPORTAL_TIMEOUT_SECONDS=30

# Configuración del geocodificador (Nominatim por defecto)
APP_GEOCODE_BASE_URL=https://nominatim.openstreetmap.org
APP_GEOCODE_TIMEOUT_SECONDS=10
APP_GEOCODE_USER_AGENT=MapaGasolineras/0.1
APP_GEOCODE_MAX_REQUESTS_PER_MINUTE=30
APP_GEOCODE_CACHE_MAX_SIZE=2000
APP_GEOCODE_CACHE_TTL_HOURS=24
