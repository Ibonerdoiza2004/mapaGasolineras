FROM maven:3.9.9-eclipse-temurin-21

WORKDIR /workspace

# Descarga las dependencias antes de montar el código fuente para que queden
# almacenadas en la capa de imagen y los siguientes arranques sean más rápidos.
COPY pom.xml ./
RUN mvn --batch-mode dependency:go-offline

EXPOSE 8080

CMD ["mvn", "--batch-mode", "spring-boot:run"]
