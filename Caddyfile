https://{$DOMAIN} {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
	}

	encode zstd gzip
	reverse_proxy backend:8080
}

# Mapa vectorial PMTiles y tipografías. MAP_DOMAIN debe resolver a esta VM.
https://{$MAP_DOMAIN} {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Access-Control-Allow-Origin "{$MAP_ALLOWED_ORIGIN}"
		Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
		Access-Control-Allow-Headers "Range, If-None-Match, If-Modified-Since"
		Access-Control-Expose-Headers "Accept-Ranges, Content-Length, Content-Range, ETag"
		Vary Origin
	}

	@preflight method OPTIONS
	handle @preflight {
		respond 204
	}

	@pmtiles path /maps/*.pmtiles
	@versioned path_regexp versioned ^/maps/spain-[0-9]{8}T[0-9]{6}Z\.pmtiles$
	handle @pmtiles {
		root * /srv/maps
		header Content-Type application/vnd.pmtiles
		header Cache-Control "public, max-age=3600, must-revalidate"
		header @versioned Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	@fonts path /fonts/*
	handle @fonts {
		root * /srv/maps
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	@context path /context/*
	handle @context {
		root * /srv/maps
		header Content-Type application/geo+json
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		respond 404
	}
}
