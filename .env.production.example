# Configuración del despliegue público. La integración continua escribe este
# archivo en el servidor de Oracle con los valores guardados en GitHub Secrets;
# no guardes aquí credenciales reales.
DOMAIN=api.gasolineras.example.com
CORS_ALLOWED_ORIGINS=https://gasolineras.example.com
POSTGRES_DB=gasolineras_prod
POSTGRES_USER=gasolineras
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Retardo de la primera importación de precios (ms); por defecto 15 min.
APP_IMPORT_INITIAL_DELAY_MS=900000
# Intervalo de refresco de precios (ms); por defecto 1 hora.
APP_IMPORT_INTERVAL_MS=3600000
