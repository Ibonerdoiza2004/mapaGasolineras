# Configuración del despliegue público. La integración continua escribe este
# archivo en el servidor de Oracle con los valores guardados en GitHub Secrets;
# no guardes aquí credenciales reales.
DOMAIN=api.gasolineras.example.com
MAP_DOMAIN=tiles.gasolineras.example.com
CORS_ALLOWED_ORIGINS=https://gasolineras.example.com
MAP_ALLOWED_ORIGIN=https://gasolineras.example.com
# Directorio persistente de la VM; no debe estar dentro de la carpeta que el
# despliegue reemplaza.
MAP_DATA_DIR=/home/usuario/mapaGasolineras-map-data/publish
POSTGRES_DB=gasolineras_prod
POSTGRES_USER=gasolineras
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Retardo de la primera importación de precios (ms); por defecto 3 min.
APP_IMPORT_INITIAL_DELAY_MS=180000
# Intervalo de refresco de precios (ms); por defecto 1 hora.
APP_IMPORT_INTERVAL_MS=3600000
# Reintentos ante el bloqueo intermitente del proveedor (WAF corta conexiones
# y handshakes TLS del cliente Java); por defecto 4 intentos con 30 s de espera.
APP_GEOPORTAL_RETRY_MAX_ATTEMPTS=4
APP_GEOPORTAL_RETRY_DELAY_MS=30000
