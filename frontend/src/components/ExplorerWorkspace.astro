---
import '../styles/explorer.css';

const stations = [
	{
		name: 'Estación Norte',
		brand: 'Marca independiente',
		address: 'Av. de la Industria, 24',
		price: '1,459 €/l',
		distance: '1,2 km',
		tag: 'Mejor precio',
	},
	{
		name: 'Gasolinera Centro',
		brand: 'Red nacional',
		address: 'Calle Mayor, 108',
		price: '1,479 €/l',
		distance: '2,4 km',
		tag: '',
	},
	{
		name: 'Área de servicio Este',
		brand: 'Red nacional',
		address: 'Carretera M-30, km 12',
		price: '1,489 €/l',
		distance: '3,8 km',
		tag: '',
	},
];
---

<section class="explorer" aria-label="Explorador de gasolineras">
	<details class="explorer__sidebar" open>
		<summary>
			<span class="explorer__grabber" aria-hidden="true"></span>
			<span><strong>Gasolineras cercanas</strong><small>12 resultados</small></span>
			<span class="explorer__summary-icon" aria-hidden="true">⌃</span>
		</summary>
		<div class="explorer__sidebar-content">
			<div class="explorer__sidebar-heading">
				<div>
					<p class="eyebrow">Explorar</p>
					<h1>Gasolineras cercanas</h1>
				</div>
				<span class="explorer__result-count" aria-label="12 resultados">12</span>
			</div>

		<form class="explorer__filters" aria-label="Filtros de búsqueda">
			<label class="explorer__field">
				<span>Ubicación</span>
				<div class="explorer__input-wrap">
					<span aria-hidden="true">⌖</span>
					<input type="search" placeholder="Ciudad, dirección o código postal" />
				</div>
			</label>

			<div class="explorer__filter-row">
				<label class="explorer__field">
					<span>Combustible</span>
					<select>
						<option>Diésel</option>
						<option>Gasolina 95</option>
						<option>Gasolina 98</option>
					</select>
				</label>
				<label class="explorer__field">
					<span>Radio</span>
					<select>
						<option>5 km</option>
						<option>10 km</option>
						<option>25 km</option>
					</select>
				</label>
			</div>

			<button class="explorer__location" type="button">
				<span aria-hidden="true">◎</span>
				Usar mi ubicación
			</button>
		</form>

		<div class="explorer__list-heading">
			<h2>Resultados</h2>
			<label>
				<span class="visually-hidden">Ordenar resultados</span>
				<select>
					<option>Mejor opción</option>
					<option>Menor precio</option>
					<option>Menor distancia</option>
				</select>
			</label>
		</div>

		<div class="explorer__stations">
			{stations.map((station, index) => (
				<article class:list={["station-card", { "station-card--featured": index === 0 }]}>
					<div class="station-card__topline">
						<div>
							{station.tag && <span class="station-card__tag">{station.tag}</span>}
							<h3>{station.name}</h3>
						</div>
						<strong>{station.price}</strong>
					</div>
					<p class="station-card__brand">{station.brand}</p>
					<p class="station-card__address">{station.address}</p>
					<div class="station-card__meta">
						<span>{station.distance}</span>
						<span>Actualizado hoy</span>
					</div>
				</article>
			))}
		</div>
		</div>
	</details>

	<div class="explorer__map" role="img" aria-label="Mapa de gasolineras cercanas">
		<div class="map-grid" aria-hidden="true"></div>
		<div class="map-road map-road--horizontal" aria-hidden="true"></div>
		<div class="map-road map-road--vertical" aria-hidden="true"></div>
		<div class="map-label map-label--north" aria-hidden="true">Zona Norte</div>
		<div class="map-label map-label--south" aria-hidden="true">Centro</div>
		<span class="map-marker map-marker--active" style="--marker-x: 42%; --marker-y: 34%" aria-hidden="true">1</span>
		<span class="map-marker" style="--marker-x: 64%; --marker-y: 52%" aria-hidden="true">2</span>
		<span class="map-marker" style="--marker-x: 30%; --marker-y: 69%" aria-hidden="true">3</span>
		<span class="map-marker" style="--marker-x: 76%; --marker-y: 26%" aria-hidden="true">4</span>
		<div class="map-controls" aria-label="Controles del mapa">
			<button type="button" aria-label="Acercar mapa">+</button>
			<button type="button" aria-label="Alejar mapa">−</button>
		</div>
		<div class="map-attribution">Mapa base preparado para Leaflet · OpenStreetMap</div>
	</div>
</section>
