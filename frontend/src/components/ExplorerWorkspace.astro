---
import '../styles/explorer.css';
import BrandFilter from './BrandFilter';
import ComparePanel from './ComparePanel';
import FuelFilter from './FuelFilter';
import LeafletMap from './LeafletMap';
import LocationButton from './LocationButton';
import PriceFilter from './PriceFilter';
import RadioFilter from './RadioFilter';
import SearchBox from './SearchBox';
import SortFilter from './SortFilter';
import StationDetail from './StationDetail';
import StationList from './StationList';
import { SPAIN_BOUNDS } from '../lib/spainBounds';
---

<section class="explorer" aria-label="Explorador de gasolineras">
	<details class="explorer__sidebar" open>
		<summary aria-label="Gasolineras cercanas">
			<span class="explorer__summary-toggle">
				<span class="explorer__summary-arrow" aria-hidden="true">▾</span>
				<span class="explorer__summary-count"><small>0 resultados</small></span>
			</span>
		</summary>
		<div class="explorer__sidebar-content">
		<div class="explorer__sidebar-heading">
			<div>
				<p class="eyebrow">Explorar</p>
				<h1>Gasolineras cercanas</h1>
			</div>
		</div>

		<form class="explorer__filters" aria-label="Filtros de búsqueda">
			<LocationButton client:load />

			<div class="explorer__field">
				<label class="visually-hidden" for="explorer-search">Ubicación</label>
				<SearchBox client:load />
			</div>

			<RadioFilter client:load />

			<BrandFilter client:idle />

			<FuelFilter client:load />

			<PriceFilter client:idle />
		</form>

		<div class="explorer__list-heading">
			<div class="explorer__list-title">
				<h2>Resultados</h2>
				<span class="explorer__result-count" aria-label="0 resultados">0</span>
			</div>
			<div class="explorer__list-actions">
				<SortFilter client:load />
			</div>
		</div>

		<StationList client:load />
		</div>
	</details>

	<div class="explorer__map">
		<LeafletMap
			client:idle
			stations={[]}
			center={[40.4168, -3.7038]}
			zoom={13}
			bounds={SPAIN_BOUNDS}
		/>
		<StationDetail client:idle />
	</div>

	<ComparePanel client:idle />
</section>

<script>
	import { enhanceExplorerPanel } from './explorerPanel';

	const panel = document.querySelector<HTMLDetailsElement>('.explorer__sidebar');
	if (panel) {
		enhanceExplorerPanel(panel);
	}
</script>
