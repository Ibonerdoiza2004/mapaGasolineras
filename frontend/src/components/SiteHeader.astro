---
import ThemeToggle from './ThemeToggle';
import '../styles/site-header.css';
import '../styles/theme-toggle.css';
import { getActiveSection } from '../config/navigation';
import { seo } from '../config/seo';

const currentPath = Astro.url.pathname;
const activeSection = getActiveSection(currentPath);
const isExploreActive = activeSection === 'explore';
const isRoutesActive = activeSection === 'routes';
---

<header class="site-header">
	<a class="site-header__brand" href="/" aria-label={`${seo.siteName}, inicio`}>
		<svg
			class="site-header__brand-mark"
			aria-hidden="true"
			xmlns="http://www.w3.org/2000/svg"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"
		>
			<line x1="3" x2="15" y1="22" y2="22" />
			<line x1="4" x2="14" y1="9" y2="9" />
			<path d="M14 22V4a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v18" />
			<path d="M14 13h2a2 2 0 0 1 2 2v2a2 2 0 0 0 2 2 2 2 0 0 0 2-2V9.83a2 2 0 0 0-.59-1.42L18 5" />
		</svg>
		<span>{seo.siteName}</span>
	</a>

	<nav class="site-header__nav" aria-label="Navegación principal">
		<a
			href="/"
			class:list={{ active: isExploreActive }}
			aria-current={isExploreActive ? 'page' : undefined}
		>Explorar</a>
		<a
			href="/rutas"
			class:list={{ active: isRoutesActive }}
			aria-current={isRoutesActive ? 'page' : undefined}
		>Rutas</a>
	</nav>

	<div class="site-header__actions">
		<ThemeToggle client:load />
	</div>
</header>
