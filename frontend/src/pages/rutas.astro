---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { seo } from '../config/seo';
---

<BaseLayout title={seo.routes.title} description={seo.routes.description}>
	<SiteHeader />
	<main class="route-placeholder">
		<p class="route-placeholder__eyebrow">Próximamente</p>
		<h1>Planificador de rutas</h1>
		<p>
			Aquí podrás planificar tu viaje y encontrar paradas de repostaje que
			combinen ahorro y un desvío razonable.
		</p>
		<a href="/">Volver a explorar gasolineras</a>
	</main>
</BaseLayout>

<style>
	.route-placeholder {
		margin: 0 auto;
		max-width: 48rem;
		padding: var(--space-12) var(--space-6);
	}

	.route-placeholder__eyebrow {
		color: var(--color-brand-700);
		font-size: var(--font-size-sm);
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.route-placeholder h1 {
		color: var(--color-text);
		font-size: clamp(var(--font-size-xl), 5vw, var(--font-size-2xl));
		margin-block: var(--space-3);
	}

	.route-placeholder p:not(.route-placeholder__eyebrow) {
		color: var(--color-text-muted);
		max-width: 36rem;
	}

	.route-placeholder a {
		color: var(--color-brand-700);
		display: inline-block;
		font-weight: 600;
		margin-top: var(--space-4);
	}
</style>
