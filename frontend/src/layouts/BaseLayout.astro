---
import '../styles/tokens.css';
import '../styles/layout.css';
import { seo } from '../config/seo';

interface Props {
	title: string;
	description?: string;
	/** Objeto o lista de objetos JSON-LD (datos estructurados para SEO). */
	jsonLd?: object | object[];
	/** Impide la indexación de la página (p. ej. páginas internas sin valor SEO). */
	noindex?: boolean;
}

const {
	title,
	description = 'Encuentra y compara gasolineras cercanas.',
	jsonLd,
	noindex = false,
} = Astro.props;

const siteUrl = (import.meta.env.PUBLIC_SITE_URL as string | undefined ?? 'https://example.com').replace(
	/\/$/,
	'',
);
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const jsonLdList = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];
const ldJson = jsonLdList.length > 0 ? JSON.stringify(jsonLdList) : null;

// Preconecta únicamente con el origen HTTPS del PMTiles configurado.
const rawMapUrl = (import.meta.env.PUBLIC_MAP_PMTILES_URL as string | undefined)?.trim();
let mapOrigin: string | null = null;
if (rawMapUrl?.startsWith('https://')) {
	try {
		mapOrigin = new URL(rawMapUrl).origin;
	} catch {
		// Una URL inválida no produce una conexión especulativa.
	}
}
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={seo.siteName} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		{mapOrigin && <link rel="preconnect" href={mapOrigin} crossorigin />}
		<link rel="preconnect" href={siteUrl} crossorigin />
		<script is:inline>
			try {
				const savedTheme = localStorage.getItem('gasolineras-theme');
				const theme =
					savedTheme === 'light' || savedTheme === 'dark'
						? savedTheme
						: window.matchMedia('(prefers-color-scheme: dark)').matches
							? 'dark'
							: 'light';
				document.documentElement.dataset.theme = theme;
				// El selector de tema lee este valor en su inicializador de estado
				// para que la hidratación coincida con el DOM corregido.
				window.__gasolinerasTheme = theme;
			} catch {
				// El tema del sistema se aplica mediante CSS si el almacenamiento no está disponible.
			}
		</script>
		{ldJson && <script type="application/ld+json" set:html={ldJson} />}
		<title>{title}</title>
	</head>
	<body>
		<div class="app-shell">
			<slot />
		</div>
		<script is:inline>
			// Corrige la etiqueta del selector de tema antes de la primera pintura
			// para evitar el parpadeo de "Oscuro" al cargar o volver a la pestaña.
			(() => {
				const theme = window.__gasolinerasTheme;
				if (theme !== 'light' && theme !== 'dark') return;
				const button = document.getElementById('theme-toggle');
				if (!button) return;
				const dark = theme === 'dark';
				const label = dark ? 'Activar modo claro' : 'Activar modo oscuro';
				button.setAttribute('aria-label', label);
				button.setAttribute('title', label);
				button.setAttribute('aria-pressed', String(dark));
				// El icono del selector se muestra según el tema mediante CSS
				// (`[data-theme="dark"]` en <html>); aquí solo se corrige el texto.
				// La etiqueta es el segundo hijo directo del botón (el primero es
				// el contenedor de iconos).
				const spans = button.querySelectorAll(':scope > span');
				const text = spans[1];
				if (text) text.textContent = dark ? 'Claro' : 'Oscuro';
			})();
		</script>
	</body>
</html>
