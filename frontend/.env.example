# Valores del Compose local. El backend no necesita variables del mapa.
PUBLIC_API_URL=http://localhost:8080
PUBLIC_MAP_PMTILES_URL=http://localhost:8081/maps/spain.pmtiles
# Origen que expone /fonts. Si se omite, se deriva de la URL del PMTiles.
PUBLIC_MAP_ASSET_URL=http://localhost:8081

# En desarrollo, al abrir la web desde otro dispositivo de la LAN, sustituye
# localhost por la IP del equipo que ejecuta Docker:
# PUBLIC_API_URL=http://192.168.1.115:8080
# PUBLIC_MAP_PMTILES_URL=http://192.168.1.115:8081/maps/spain.pmtiles
# PUBLIC_MAP_ASSET_URL=http://192.168.1.115:8081

# URL pública del sitio (sin barra final). Se usa para el canonical, el sitemap,
# robots.txt y los datos estructurados. En producción la define el despliegue.
PUBLIC_SITE_URL=http://localhost:4321
