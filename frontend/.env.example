# Proveedor de mapas configurable por entorno.
PUBLIC_MAP_LIBRARY=leaflet

# URL de las teselas del mapa (por defecto OpenStreetMap). Para servir WebP/AVIF,
# apuntar a un proxy o proveedor que sirva ese formato. El patrón es {z}/{x}/{y} y
# el sufijo define el formato (`.png`, `.webp`, `.avif`). En `tile-proxy/` hay un
# proxy autocontenido (Node + sharp) que convierte las teselas de OSM a WebP y las
# cachea; se despliega en la VM y se expone, p. ej., como https://tiles.DOMINIO:
#   PUBLIC_MAP_TILE_URL=https://tiles.ahorrarepostando.es/{z}/{x}/{y}.png
# PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# URL pública del sitio (sin barra final). Se usa para el canonical, el sitemap,
# robots.txt y los datos estructurados. En producción la define el despliegue.
PUBLIC_SITE_URL=http://localhost:4321