FROM node:22-bookworm

WORKDIR /app

# Las dependencias se instalan en la imagen; el navegador de Playwright se
# descarga una única vez y queda cacheado en la capa de imagen.
COPY package.json package-lock.json ./
RUN npm ci

RUN npx playwright install --with-deps chromium

COPY . .

CMD ["npm", "run", "test"]
