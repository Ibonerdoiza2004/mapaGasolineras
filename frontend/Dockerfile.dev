FROM node:22-alpine

WORKDIR /app

# Las dependencias se instalan en la imagen y se conservan en un volumen al
# montar el código fuente durante el desarrollo.
COPY package.json package-lock.json ./
RUN npm ci \
	&& sha256sum package-lock.json | awk '{ print $1 }' > node_modules/.package-lock.sha256

COPY entrypoint.dev.sh /usr/local/bin/frontend-entrypoint-dev

EXPOSE 4321

CMD ["sh", "/usr/local/bin/frontend-entrypoint-dev"]
