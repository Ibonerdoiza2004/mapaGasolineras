/*
	X-Content-Type-Options: nosniff
	X-Frame-Options: DENY
	Referrer-Policy: strict-origin-when-cross-origin
	Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=()
	Strict-Transport-Security: max-age=31536000; includeSubDomains
	Cross-Origin-Opener-Policy: same-origin
	Cross-Origin-Resource-Policy: same-origin
	Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https:; font-src 'self' data:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
